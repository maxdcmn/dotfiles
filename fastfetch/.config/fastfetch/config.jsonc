{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/icon.txt",
    "type": "file",
    "padding": {
      "top": 1,
      "right": 2
    }
  },
  "display": {
    "separator": " → "
  },
  "modules": [
    "break",
    {
      "type": "title",
      "format": "{user-name}@{host-name}"
    },
    {
      "type": "os",
      "key": "os"
    },
    {
      "type": "kernel",
      "key": "ker"
    },
    {
      "type": "shell",
      "key": "sh"
    },
    {
      "type": "terminal",
      "key": "term"
    },
    {
      "type": "cpu",
      "key": "cpu"
    },
    {
      "type": "memory",
      "key": "mem"
    },
    {
      "type": "uptime",
      "key": "up"
    },
    "break"
  ]
}
